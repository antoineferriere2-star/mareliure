SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Server-only, never exposed to the client bundle. Required for admin server
# functions and the public API routes (client.server.ts).
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"
IP_HASH_SALT="replace-with-a-long-random-string"

# AI Engine (src/build/ai/) — powers the admin-triggered "Analyser avec l'IA"
# action on Dossier pages. Uses Lovable AI Gateway; LOVABLE_API_KEY is
# auto-provisioned by Lovable Cloud. Optional override:
# LOVABLE_AI_MODEL="google/gemini-3.6-flash"

# Stripe billing (src/lib/stripe.server.ts) — self-service checkout/portal
# for Espace Client plans. All four are auto-provisioned by Lovable Cloud
# once Stripe is connected (see PLAN_DEFAULTS in src/build/billing/plans.ts
# for the plan <-> Stripe Price lookup_key mapping). These are opaque
# connector ids, NOT real Stripe API keys — see src/lib/stripe.server.ts.
STRIPE_SANDBOX_API_KEY="replace-with-lovable-sandbox-connection-id"
STRIPE_LIVE_API_KEY="replace-with-lovable-live-connection-id"
PAYMENTS_SANDBOX_WEBHOOK_SECRET="whsec_xxx"
PAYMENTS_LIVE_WEBHOOK_SECRET="whsec_xxx"
